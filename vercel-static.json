{
  "version": 2,
  "builds": [
    {
      "src": "static/(.*)",
      "use": "@vercel/static"
    },
    {
      "src": "index-static.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/ads.txt",
      "dest": "/static/ads.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/index-static.html"
    }
  ]
}